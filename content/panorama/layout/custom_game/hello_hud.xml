<root>
    <scripts>
        <include src="file://{resources}/scripts/custom_game/main-bundle.js"/>
    </scripts>
    <styles>
        <include src="s2r://panorama/styles/dotastyles.css"/>
        <include src="file://{resources}/styles/custom_game/main-bundle.css"/>
    </styles>
    <snippets>
        <snippet name="UnitCardWrapper">
            <Panel class="UnitCardZXC" hittest="false">
                <Panel id="CardTransformWrapperX" class="CardTransformWrapper" hittest="false">
                    <Label id="CardQuantity" hittest="false"/>
                    <Button id="ShopItemX" class="ShopItem"/>
                </Panel>
            </Panel>
            <Panel class="UnitCardZXCTWO" hittest="false">
                <Panel id="CardTransformWrapperX" class="CardTransformWrapper" hittest="false">
                    <Label id="CardQuantity" hittest="false"/>
                    <Button id="ShopItemX" class="ShopItem"/>
                </Panel>
            </Panel>
        </snippet>
        <snippet name="UnitCardContents">
            <Panel>
                <Panel id="CardBack"/>
                <Label id="CardTypeBG" class="ShopItemBG"/>
                <Label id="CardFoil" hittest="false"/>
                <Panel id="CardRarityIconWrapper" hittest="false">
                    <Label id="CardRarityIcon" hittest="false"/>
                    <Label id="CardRarityIcon2" hittest="false"/>
                </Panel>
                <Panel id="CardHeader">
                    <Label id="CardLevel"/>
                    <Panel id="CardTitleWrapper">
                        <Label id="CardSuperTitle"/>
                        <Label id="CardTitle"/>
                    </Panel>
                </Panel>
                <Panel id="CardDetails">
                    <Label id="CardDescription"/>
                </Panel>
                <Panel id="CardCostContainer">
                    <Label id="CardCostIcon"/>
                    <Label id="CardCost"/>
                </Panel>
                <Panel id="CardTypes"/>
                <Panel id="TradeIcon"/>
                <Panel id="XpButton" hittest="true">
                    <Panel id="XpButtonInner" hittest="true"/>
                    <Panel id="XpButtonCornerInner">
                        <Label id="XpButtonLabel" hittest="false" text="XP"/>
                        <Panel id="XpButtonImage" hittest="false"/>
                    </Panel>
                </Panel>
                <Panel id="MasterBallButton">
                    <Panel id="MasterBallButtonInner"/>
                    <Panel id="MasterBallButtonCornerInner">
                        <Panel id="MasterBallButtonImage" hittest="false"/>
                    </Panel>
                </Panel>
                <Panel id="ShopItemPortraitBG"/>
                <Label id="CardImage"/>
                <DOTAScenePanel id="ShopItemPortrait" antialias="false" hittest="false" light="light" particleonly="false"/>
            </Panel>
        </snippet>
        <snippet name="AvatarAbilityButton">
            <Panel>
                <Label id="BindingLabel"/>
                <Panel id="CardCostContainer">
                    <Label id="CardCostIcon"/>
                    <Label id="CardCost"/>
                </Panel>
                <DOTAAbilityImage id="AbilityImage" hittest="true"/>
            </Panel>
        </snippet>
        <snippet name="WideAbilityPanel">
            <Panel>
                <Label id="OptionLabel"/>
                <DOTAAbilityImage id="OptionBGImage"/>
            </Panel>
        </snippet>
        <snippet name="TradeWindow">
            <Panel class="TradeWindow Dialog">
                <Panel style="width: 100%; vertical-align: top;">
                    <Label id="TradeTitle" text="Trade"/>
                    <Label id="CancelTradeButton" class="DialogButton Red Icon" text="×"/>
                </Panel>
                <Panel id="TradeUnitPanel">
                    <Panel id="TradeUnitSelector"/>
                </Panel>
                <Panel id="TradeSummary">
                    <Label text="Do you want to trade your"/>
                    <Label id="TradeSummaryFirstUnit" text=""/>
                    <Label text="for"/>
                    <Label id="TradeSummarySecondUnit" text=""/>
                </Panel>
                <Panel style="width: 100%; vertical-align: bottom;">
                    <Label id="ConfirmTradeButton" class="DialogButton" text="Confirm"/>
                </Panel>
            </Panel>
        </snippet>
        <snippet name="TradeUnitOption">
            <Panel class="TradeUnitOption">
                <DOTAScenePanel id="TradeUnitOptionPortrait" antialias="false" hittest="false" light="light" particleonly="false"/>
            </Panel>
        </snippet>
        <snippet name="UnitFrame">
            <Panel class="UnitFrame" disablefocusonmousedown="true">
                <Panel id="UnitFrameCore" class="UnitFrameCore" disablefocusonmousedown="true" hittest="true">
                    <Label id="UnitFrameLevel" text="0"/>
                    <Label id="UnitFrameName" text=""/>
                    <Panel id="UnitFrameBG" class="TypeBG"/>
                    <Panel id="UnitFramePortraitBG"/>
                    <Panel id="UnitTypes"/>
                    <DOTAScenePanel id="UnitFramePortrait" antialias="true" hittest="false" light="light" particleonly="false"/>
                    <Panel id="MovePanel">
                        <Panel id="MoveSelector1" class="MoveSelector" hittest="true"/>
                        <Panel id="MoveSelector2" class="MoveSelector" hittest="true"/>
                        <Panel id="MoveSelector3" class="MoveSelector" hittest="true"/>
                        <Panel id="MoveSelector4" class="MoveSelector" hittest="true"/>
                    </Panel>
                </Panel>
                <Panel id="SidePane">
                    <Panel id="SpecializationPane"/>
                    <Panel id="ItemPane">
                        <Panel id="ItemSelector" class="MoveSelector" hittest="true"/>
                    </Panel>
                </Panel>
            </Panel>
        </snippet>
    </snippets>
    <Panel class="MainHud" hittest="false">
        <Panel id="FloatingTextRoot"/>
        <Panel id="x3DUIRoot">
            <Panel id="BenchSlot3d0" class="BenchSlot3d">
                <Label id="BenchSlot3dLabel"/>
            </Panel>
            <Panel id="BenchSlot3d1" class="BenchSlot3d">
                <Label id="BenchSlot3dLabel"/>
            </Panel>
            <Panel id="BenchSlot3d2" class="BenchSlot3d">
                <Label id="BenchSlot3dLabel"/>
            </Panel>
            <Panel id="BenchSlot3d3" class="BenchSlot3d">
                <Label id="BenchSlot3dLabel"/>
            </Panel>
            <Panel id="BenchSlot3d4" class="BenchSlot3d">
                <Label id="BenchSlot3dLabel"/>
            </Panel>
            <Panel id="BenchSlot3d5" class="BenchSlot3d">
                <Label id="BenchSlot3dLabel"/>
            </Panel>
            <Panel id="AddBenchSlotButton" class="BenchSlot3d">
                <Label id="BenchSlot3dLabel" text="+"/>
                <Label id="BenchSlot3dIcon"/>
            </Panel>
        </Panel>
        <Panel id="Vignette" hittest="false"/>
        <Panel id="VV1" hittest="false"/>
        <Panel id="VV2" hittest="false"/>
        <Panel id="RootPanel" hittest="false">
            <Panel id="PopupLayer" hittest="false" onload="" style="x:0; y:0; width: 100%; height: 100%;"/>
            <Panel id="Announcer">
                <Label id="AnnouncerText"/>
            </Panel>
            <Panel id="UnitFrames" class="UnitFramesContainer" hittest="false">
                <Panel id="UnitFrame1"/>
                <Panel id="UnitFrame2"/>
                <Panel id="UnitFrame3"/>
                <Panel id="UnitFrame4"/>
                <Panel id="UnitFrame5"/>
                <Panel id="UnitFrame6"/>
            </Panel>
            <Panel id="TopLeftShadow"/>
            <Panel id="BottomHud" style="flow-children: down;">
                <Panel id="DexTop"/>
                <Panel id="SelectedUnitLevelContainer">
                    <Label id="SelectedUnitLevel" text="0"/>
                </Panel>
                <Panel id="DexContents" style="flow-children: down;">
                    <Panel id="SelectedUnitTitle">
                        <Label id="SelectedUnitName" text=""/>
                        <Panel id="SelectedUnitTypes" style="flow-children: right;"/>
                    </Panel>
                    <Panel id="SelectedUnit">
                        <Panel id="SelectedUnitLeft">
                            <Panel id="SelectedUnitStatsLeft">
                                <Panel class="SelectedUnitStatRow">
                                    <Label class="SelectedUnitStatLabel" text="HP: "/>
                                    <Label id="SelectedUnitStats1" class="SelectedUnitStatValueLabel" text=""/>
                                </Panel>
                                <Panel class="SelectedUnitStatRow">
                                    <Label class="SelectedUnitStatLabel" text="Speed: "/>
                                    <Label id="SelectedUnitStats2" class="SelectedUnitStatValueLabel" text=""/>
                                </Panel>
                                <Panel class="SelectedUnitStatRow">
                                    <Label class="SelectedUnitStatLabel" text="Atk: "/>
                                    <Label id="SelectedUnitStats3" class="SelectedUnitStatValueLabel" text=""/>
                                </Panel>
                                <Panel class="SelectedUnitStatRow">
                                    <Label class="SelectedUnitStatLabel" text="Sp.Atk: "/>
                                    <Label id="SelectedUnitStats4" class="SelectedUnitStatValueLabel" text=""/>
                                </Panel>
                                <Panel class="SelectedUnitStatRow">
                                    <Label class="SelectedUnitStatLabel" text="Def: "/>
                                    <Label id="SelectedUnitStats5" class="SelectedUnitStatValueLabel" text=""/>
                                </Panel>
                                <Panel class="SelectedUnitStatRow">
                                    <Label class="SelectedUnitStatLabel" text="Sp.Def: "/>
                                    <Label id="SelectedUnitStats6" class="SelectedUnitStatValueLabel" text=""/>
                                </Panel>
                            </Panel>
                        </Panel>
                        <Panel id="SelectedUnitRight">
                            <Panel id="SelectedUnitPortraitSection">
                                <DOTAScenePanel id="SelectedUnitPortrait" antialias="false" hittest="false" light="light" particleonly="false"/>
                                <Panel id="SelectedUnitExtra"/>
                            </Panel>
                        </Panel>
                    </Panel>
                    <Panel id="SelectedUnitAbilityPanel" style="flow-children: right;">
                        <Panel id="SelectedUnitItem"/>
                        <Panel id="SelectedUnitAbilities"/>
                    </Panel>
                    <Panel id="DexBottom"/>
                </Panel>
            </Panel>
            <Panel id="Inventory" hittest="false">
                <Button id="CardDeleteButton"/>
                <Panel id="InventoryHand" hittest="false"/>
            </Panel>
            <Panel id="BottomAbilitiesContainer"/>
            <Panel id="ShopPanel" class="Hidden" hittest="false">
                <Panel id="ShopPanelInner">
                    <Panel id="CurrentGoldContainer">
                        <Label id="GoldIcon"/>
                        <Label id="GoldLabel"/>
                    </Panel>
                    <Panel id="UpgradePoints">
                        <Label id="UpgradePointsIcon" text="»"/>
                        <Label id="UpgradePointsLabel" text="0"/>
                    </Panel>
                    <Panel id="ShopItemContainerGlow"/>
                    <Panel id="ShopItemContainer"/>
                    <Panel id="ShopAbilitiesContainer"/>
                    <Label id="ShopCloseButton" class="DialogButton Red Icon" text="×"/>
                    <Panel id="UpgradePanel" onfocus="">
                        <Panel id="UpgradeContentWrapper" onfocus="">
                            <Panel id="UpgradeBackground"/>
                            <Panel id="UpgradeContainer" onfocus="DropInputFocus()"/>
                        </Panel>
                    </Panel>
                    <Panel id="ShopLockButton"/>
                </Panel>
                <Panel id="UnitCard1" class="UnitCard" hittest="false">
                    <Panel id="CardTransformWrapper1" class="CardTransformWrapper" hittest="false">
                        <Button id="ShopItem1" class="ShopItem"/>
                    </Panel>
                </Panel>
                <Panel id="UnitCard2" class="UnitCard" hittest="false">
                    <Panel id="CardTransformWrapper2" class="CardTransformWrapper" hittest="false">
                        <Button id="ShopItem2" class="ShopItem"/>
                    </Panel>
                </Panel>
                <Panel id="UnitCard3" class="UnitCard" hittest="false">
                    <Panel id="CardTransformWrapper3" class="CardTransformWrapper" hittest="false">
                        <Button id="ShopItem3" class="ShopItem"/>
                    </Panel>
                </Panel>
                <Panel id="UnitCard4" class="UnitCard" hittest="false">
                    <Panel id="CardTransformWrapper4" class="CardTransformWrapper" hittest="false">
                        <Button id="ShopItem4" class="ShopItem"/>
                    </Panel>
                </Panel>
                <Panel id="UnitCard5" class="UnitCard" hittest="false">
                    <Panel id="CardTransformWrapper5" class="CardTransformWrapper" hittest="false">
                        <Button id="ShopItem5" class="ShopItem"/>
                    </Panel>
                </Panel>
            </Panel>
            <Panel id="GameStatusPanel">
                <Panel id="TimerPanel">
                    <ProgressBar id="TimerProgressBar" max="100" min="0" value="100"/>
                    <Label id="TimerLabel" text=""/>
                </Panel>
                <Panel id="GameStatusBar">
                    <Label id="RoundLabel" text="Round 0"/>
                    <Panel id="GameState">
                        <Panel id="GameStateWrapper">
                            <Label id="GameStateText" text=""/>
                            <Label id="GameStateIcon" text=""/>
                        </Panel>
                    </Panel>
                    <Label id="PocketBallIcon"/>
                    <Label id="PocketUnitCount" text="0"/>
                    <Label id="PocketBenchSize" text="/2"/>
                    <Panel id="AvatarAbilities"/>
                </Panel>
                <Panel id="HpBar">
                    <Label id="HpLabel" text="100"/>
                    <ProgressBar id="HpProgressBar" max="100" min="0" value="100"/>
                </Panel>
            </Panel>
            <Label id="BigTimerLabel" text=""/>
            <Panel id="EventLog" hittest="false">
                <Panel id="Events" onfocus="DropInputFocus()"/>
            </Panel>
        </Panel>
    </Panel>
</root>
