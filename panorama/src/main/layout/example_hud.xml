<root>
    <!--
        Plain hand-written Panorama XML layout — the alternative to the Layout DSL used by
        game_hud.dota.xml.kts. Logic still comes from Kotlin: PanoramaInit.js is transpiled
        from PanoramaInit.kt and panoramaInit() runs on load. Styled by plain CSS
        (example_hud.css) rather than SCSS. Mounted as a second Hud element by
        custom_ui_manifest.xml — a small bottom-left addon-version credit.
    -->
    <scripts>
        <include src="file://{resources}/scripts/custom_game/shared/AddonInfo.js" />
        <include src="file://{resources}/scripts/custom_game/PanoramaPanel.js" />
        <include src="file://{resources}/scripts/custom_game/PanoramaInit.js" />
    </scripts>
    <styles>
        <include src="s2r://panorama/styles/dotastyles.css" />
        <include src="file://{resources}/styles/custom_game/example_hud.css" />
    </styles>
    <Panel id="ExampleCredits" class="ExampleCredits" hittest="false" onload="panoramaInit()">
        <Label class="CreditLabel" text="" />
    </Panel>
</root>
